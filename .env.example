# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own credentials.
# `.env` is git-ignored; no working key is ever committed to this repository.
#
# Only E14 / E15 / E17 need an LLM.  Every other experiment is CPU-only and
# deterministic.  With `E14_LLM_MODE=stub` a local stub is used instead of a
# real provider, so the code paths can be exercised without any account.
# ---------------------------------------------------------------------------

E14_LLM_API_KEY=
E14_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
E14_LLM_MODEL=glm-4-flash
E14_LLM_MODE=real

# Optional: point the repository at a data directory outside the checkout
# (default: <repo>/data ; see data/README.md)
# KBCUBE_DATA=/path/to/datasets
